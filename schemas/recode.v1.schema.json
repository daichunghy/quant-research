{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentbiz.dev/schemas/recode.v1.schema.json",
  "title": "AgentBiz recode plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operations"],
  "properties": {
    "schemaVersion": { "const": "agentbiz.recode.v1" },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "itemCode", "as"],
            "properties": {
              "kind": { "const": "reverse-score" },
              "itemCode": { "type": "string", "minLength": 1 },
              "as": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "from", "as"],
            "properties": {
              "kind": { "const": "copy-as" },
              "from": { "type": "string", "minLength": 1 },
              "as": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "column", "sentinels", "as"],
            "properties": {
              "kind": { "const": "missing-code" },
              "column": { "type": "string", "minLength": 1 },
              "sentinels": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "anyOf": [{ "type": "string" }, { "type": "number" }]
                }
              },
              "as": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "as"],
            "properties": {
              "kind": { "const": "flag-straight-line" },
              "as": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "constructCode", "as"],
            "properties": {
              "kind": { "const": "construct-score" },
              "constructCode": { "type": "string", "minLength": 1 },
              "as": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$" }
            }
          }
        ]
      }
    }
  }
}
