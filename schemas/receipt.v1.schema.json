{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentbiz.dev/schemas/receipt.v1.schema.json",
  "title": "AgentBiz receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "inputDigest",
    "artifactDigest",
    "compiler",
    "findings",
    "counts"
  ],
  "properties": {
    "schemaVersion": { "const": "agentbiz.receipt.v1" },
    "status": { "enum": ["compiled", "blocked", "audited"] },
    "inputDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "artifactDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "compiler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "const": "1" }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "severity", "path", "message"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "severity": { "enum": ["error", "warning"] },
          "path": { "type": "string", "minLength": 1 },
          "message": { "type": "string", "minLength": 1 }
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "constructs": { "type": "integer", "minimum": 0 },
        "items": { "type": "integer", "minimum": 0 },
        "hypotheses": { "type": "integer", "minimum": 0 },
        "observed": { "type": "integer", "minimum": 0 },
        "rows": { "type": "integer", "minimum": 0 },
        "columns": { "type": "integer", "minimum": 0 },
        "recodedCells": { "type": "integer", "minimum": 0 },
        "straightLineRows": { "type": "integer", "minimum": 0 },
        "outOfBoundCells": { "type": "integer", "minimum": 0 },
        "missingCells": { "type": "integer", "minimum": 0 },
        "duplicateIds": { "type": "integer", "minimum": 0 },
        "warnings": { "type": "integer", "minimum": 0 },
        "errors": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
