{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentbiz.dev/schemas/topic-card.v1.schema.json",
  "title": "AgentBiz topic card v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "question",
    "claimClass",
    "population",
    "unit",
    "timeframe",
    "constructCodes",
    "hypotheses",
    "engine",
    "mode"
  ],
  "properties": {
    "schemaVersion": { "const": "agentbiz.topic-card.v1" },
    "question": { "type": "string", "minLength": 1 },
    "claimClass": { "enum": ["description", "association", "prediction", "causal"] },
    "population": { "type": "string", "minLength": 1 },
    "unit": { "type": "string", "minLength": 1 },
    "timeframe": { "type": "string", "minLength": 1 },
    "constructCodes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,31}$" }
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "from", "to"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,31}$" },
          "from": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,31}$" },
          "to": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,31}$" },
          "sign": { "enum": ["+", "-"] }
        }
      }
    },
    "engine": { "enum": ["spss", "amos", "smartpls", "lavaan"] },
    "mode": { "enum": ["confirmatory", "exploratory"] }
  }
}
