{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentbiz.dev/schemas/gap-map.v1.schema.json",
  "title": "AgentBiz gap map v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "observed"],
  "properties": {
    "schemaVersion": { "const": "agentbiz.gap-map.v1" },
    "observed": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["column"],
        "properties": {
          "column": { "type": "string", "minLength": 1 },
          "itemCode": { "type": "string", "minLength": 1 },
          "constructCode": { "type": "string", "minLength": 1 },
          "reverse": { "type": "boolean" },
          "scale": {
            "type": "object",
            "additionalProperties": false,
            "required": ["min", "max"],
            "properties": {
              "min": { "type": "integer" },
              "max": { "type": "integer" }
            }
          }
        }
      }
    }
  }
}
