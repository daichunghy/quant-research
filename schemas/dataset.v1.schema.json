{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentbiz.dev/schemas/dataset.v1.schema.json",
  "title": "AgentBiz dataset snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "columns", "rows", "rowCount"],
  "properties": {
    "schemaVersion": { "const": "agentbiz.dataset.v1" },
    "columns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "role"],
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$" },
          "role": { "enum": ["id", "demographic", "indicator", "score", "other"] },
          "itemCode": { "type": "string", "minLength": 1 }
        }
      }
    },
    "rowCount": { "type": "integer", "minimum": 0 },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": {
          "anyOf": [
            { "type": "string" },
            { "type": "number" },
            { "type": "null" }
          ]
        }
      }
    }
  }
}
