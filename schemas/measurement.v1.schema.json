{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentbiz.dev/schemas/measurement.v1.schema.json",
  "title": "AgentBiz measurement input or compiled model v1",
  "anyOf": [
    { "$ref": "#/$defs/input" },
    { "$ref": "#/$defs/model" }
  ],
  "$defs": {
    "engineOptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "estimator": { "enum": ["ML", "WLSMV", "PLS"] }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "mode"],
      "properties": {
        "schemaVersion": { "const": "agentbiz.measurement.v1" },
        "mode": { "enum": ["cb-sem", "pls-sem", "reliability-only"] },
        "strict": { "type": "boolean" },
        "engineOptions": { "$ref": "#/$defs/engineOptions" }
      }
    },
    "hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from", "to", "sign"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "sign": { "enum": ["+", "-"] }
      }
    },
    "construct": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "kind", "itemCodes", "itemCount"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["reflective", "formative"] },
        "itemCodes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "itemCount": { "type": "integer", "minimum": 1 }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "mode", "engine", "constructs", "paths"],
      "properties": {
        "schemaVersion": { "const": "agentbiz.measurement.v1" },
        "mode": { "enum": ["cb-sem", "pls-sem", "reliability-only"] },
        "engine": { "enum": ["spss", "amos", "smartpls", "lavaan"] },
        "constructs": {
          "type": "array",
          "items": { "$ref": "#/$defs/construct" }
        },
        "paths": {
          "type": "array",
          "items": { "$ref": "#/$defs/hypothesis" }
        },
        "engineOptions": { "$ref": "#/$defs/engineOptions" }
      }
    }
  }
}
